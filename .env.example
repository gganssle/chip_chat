# Chip Chat — local configuration template.
#
# Copy to .env and fill in. Every value here is a NAME or an ID, never a
# credential: secrets live in Key Vault and are read at runtime over the
# credential `az login` writes. See docs/local-setup.md, "How secrets reach a
# local process".
#
#   cp .env.example .env
#
# .env is gitignored. If you ever find yourself putting a password, token or key
# in it, stop — that value belongs in Key Vault.

# --- Azure ------------------------------------------------------------------
AZURE_SUBSCRIPTION_ID=c8b63a71-218d-4d4c-991c-b963ed2fd1f0
AZURE_TENANT_ID=afededb7-6b20-4ec3-afd5-b27ac9242bbf
AZURE_RESOURCE_GROUP=rg-chip-chat
AZURE_LOCATION=eastus2

# The vault every secret is read from. Not a secret itself.
AZURE_KEY_VAULT_NAME=kv-chip-chat-c8b63a
AZURE_KEY_VAULT_URI=https://kv-chip-chat-c8b63a.vault.azure.net/

# --- Microsoft Foundry ------------------------------------------------------
# The account, and which deployment answers for which lane. Read the live values
# with `make infra-output`; none of them are secrets.
#
# The two deployment variables are the swap point for a Phase 9 eval experiment:
# add a deployment to var.model_deployments in Terraform, point a lane at it
# here, and no code changes. Deployment names are model names on purpose, so an
# experiment never has to rename what something else is already pointing at.
CHIP_CHAT_FOUNDRY_ENDPOINT=https://aif-chip-chat-4cy39i.cognitiveservices.azure.com/
CHIP_CHAT_FOUNDRY_CHAT_DEPLOYMENT=gpt-5-mini
CHIP_CHAT_FOUNDRY_VISION_DEPLOYMENT=gpt-4.1-mini

# Pinned, not floating: a newer api-version is a different response shape, and
# Phase 9 reads its numbers off this tier.
CHIP_CHAT_FOUNDRY_API_VERSION=2024-10-21

# The Agents data-plane endpoint — threads live here. `make infra-output` prints
# it as foundry_project_endpoints["AI Foundry API"].
CHIP_CHAT_FOUNDRY_PROJECT_ENDPOINT=https://aif-chip-chat-4cy39i.services.ai.azure.com/api/projects/proj-chip-chat

# Stage 4's vocabulary: the dotted name of the enum module the catalogue build
# wrote. It is deliberately not committed — RFC-001 §07 wants the model's
# vocabulary generated from the *live* catalogue, and a checked-in module is a
# hand-maintained list with an extra step. Generate it with:
#
#   python -m chip_chat.catalog --landing landing --offline \
#       --vocabulary "$SITE_PACKAGES/chip_chat/vision_vocabulary.py"
#
# There is no default and no fallback: unset, the photo lane refuses to start
# rather than describing meals from a vocabulary nobody regenerated.
CHIP_CHAT_VISION_VOCABULARY=chip_chat.vision_vocabulary

# Where the photo lane's uploads live. Shared keys are disabled on this account,
# so this is a name and not a credential — reads go through your own identity.
CHIP_CHAT_UPLOADS_ACCOUNT=stchipchat4cy39i
CHIP_CHAT_UPLOADS_CONTAINER=uploads

# Document Intelligence, which reads any PDF nutrition sheets the harvest finds
# (issue #22). The `document_intelligence_endpoint` Terraform output — a hostname,
# not a credential; the token comes from `az login` or the container's managed
# identity. Leave it empty and the harvest still runs: it is only needed if a PDF
# is actually found, and Chipotle publishes none today.
CHIP_CHAT_DOCUMENT_INTELLIGENCE_ENDPOINT=https://di-chip-chat-4cy39i.cognitiveservices.azure.com/

# --- Databricks -------------------------------------------------------------
# Empty until the workspace exists (Phase 2). Authentication is OAuth U2M via
# `databricks auth login`, which stores its own token — no value goes here.
DATABRICKS_HOST=
DATABRICKS_CONFIG_PROFILE=chip-chat

# --- Snowflake --------------------------------------------------------------
# The trial started 2026-08-25 and runs 30 days or $400 of credits, whichever
# comes first. Everything the account contains is built by `make snowflake-apply`
# from snowflake/sql/; docs/snowflake-account.md is the write-up.
#
# The connection is defined by `snow connection add`; only names go here. No
# password, no private key, no passphrase — those live in ~/.snowflake/config.toml
# (mode 600) and in Key Vault, and never in a file that is committed.
SNOWFLAKE_CONNECTION_NAME=chipchat

# Two identifiers, both correct, and it is worth knowing which is which. The
# locator is what `snow connection add` wants and what CURRENT_ACCOUNT() returns;
# the organisation form is what Snowflake documentation calls the account
# identifier and what a URL contains.
SNOWFLAKE_ACCOUNT=hq72718.us-east-2.aws
SNOWFLAKE_ORGANIZATION_ACCOUNT=LLMPCWE-GS74649

# AWS us-east-2 (Ohio), fixed at signup and not changeable. NOT Azure East US 2 —
# see GitHub #104. Azure itself remains eastus2 and is unaffected.
SNOWFLAKE_REGION=AWS_US_EAST_2

# The serving warehouse. X-Small, suspends after 60 seconds. CHIP_CHAT_PUBLISH_WH
# is the other one, and only the nightly publish (#39) may name it.
SNOWFLAKE_WAREHOUSE=CHIP_CHAT_SERVING_WH
SNOWFLAKE_DATABASE=CHIP_CHAT

# --- Observability ----------------------------------------------------------
# Where spans go. Nothing reads this file automatically — `make dev` and
# `make trace` supply the local default themselves, and these lines matter only
# if you export them into your own shell. They are here because this is where
# you will look when repointing at Arize AX (issue #78), which is an endpoint
# and a header and nothing else. See docs/local-tracing.md.
#
# The local Phoenix container from `make dev`:
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:6006

# `k=v,k=v`. Empty locally; Arize AX wants an api_key and a space_id here — and
# those are secrets, so they come out of Key Vault rather than living in .env.
OTEL_EXPORTER_OTLP_HEADERS=

# `deployment.environment` on every span. Keeps local traces out of the views
# that are supposed to be about the deployed app.
CHIP_CHAT_ENVIRONMENT=local

# The Foundry agent resource's name — and therefore, forcibly, the `service.name`
# on every span the agent container emits. It is read rather than assumed because
# a hosted agent ignores OTEL_SERVICE_NAME, so this is the one place that knows
# which of the TWO service names in a turn belongs to the agent. Anything
# filtering on service.name must expect both; see turn_service_names() in
# otel/service.py. The default below is what the agent resource should be called
# precisely so the constraint costs nothing.
CHIP_CHAT_AGENT_NAME=chip-chat-agent

# CustomKeys connection on the Foundry project holding the OTLP headers for the
# agent. A NAME, not a credential: the agent version references it as
# ${{connections.<name>.credentials.otlp_headers}} and never carries the value.
CHIP_CHAT_OTEL_CONNECTION=otel-secrets

# --- Arize datasets ---------------------------------------------------------
# Only `make dataset-upload` reads these (issue #72). They are a different door
# from the OTLP lines above: spans go to an endpoint, datasets go through the
# vendor's REST API, and a space id is neither an endpoint nor a header.
#
# The key is a secret and belongs in Key Vault; it is named here because the SDK
# reads ARIZE_API_KEY itself and an unset one produces a worse error than a
# comment. Everything else in eval/ — building the dataset, versioning it, the
# check CI runs — needs neither of these.
ARIZE_SPACE_ID=
ARIZE_API_KEY=

# --- Agent image ------------------------------------------------------------
# Where the agent container is published. `make infra-output` prints it as
# container_registry_login_server; it is a hostname, not a credential — the
# registry's admin account is disabled and pushes authenticate as your identity.
ACR_LOGIN_SERVER=

# --- Spend cap --------------------------------------------------------------
# The inline daily ceiling and the layers under it. Every one is optional and
# defaulted small in code; see api/README.md. These are limits, not secrets.
CHIP_CHAT_DAILY_TOKEN_CEILING=
CHIP_CHAT_SESSION_TURN_CAP=
CHIP_CHAT_SESSION_TOKEN_CAP=
CHIP_CHAT_SOURCE_REQUESTS_PER_WINDOW=
CHIP_CHAT_SOURCE_WINDOW_SECONDS=
CHIP_CHAT_TURN_TOKEN_RESERVATION=

# Uploads get their own, tighter ceilings: one photograph is a Content Safety
# call, a blob write and a vision completion, so flooding them is a cost attack
# and not merely a storage one. The token charge is what an accepted upload
# costs the turn's budget before the vision model has answered.
CHIP_CHAT_SESSION_UPLOADS_PER_WINDOW=
CHIP_CHAT_SOURCE_UPLOADS_PER_WINDOW=
CHIP_CHAT_UPLOAD_WINDOW_SECONDS=
CHIP_CHAT_UPLOAD_TOKEN_CHARGE=

# "Daily" means nothing without this. Default UTC.
CHIP_CHAT_BUDGET_RESET_TIMEZONE=

# The circuit breaker. Anything not recognisably off ("", 0, false, no, off,
# run) stops the app on the next check — no restart, no deploy.
CHIP_CHAT_KILL_SWITCH=

# --- Photo uploads ----------------------------------------------------------
# Stages 1 and 2 of the vision pipeline: the ceilings a hostile upload runs into
# and the resolution a photo is reduced to. Optional and defaulted small in
# code; see vision/README.md. Limits, not secrets.
CHIP_CHAT_UPLOAD_MAX_BYTES=
CHIP_CHAT_UPLOAD_MAX_PIXELS=
CHIP_CHAT_UPLOAD_MAX_EDGE=
CHIP_CHAT_UPLOAD_JPEG_QUALITY=

# How long one upload may spend arriving. The ceiling a byte limit cannot
# express: eight mebibytes at one byte a second is under an eight mebibyte
# limit for ninety-seven days, and a few hundred of those is the worker pool.
CHIP_CHAT_UPLOAD_MAX_SECONDS=

# Where accepted photos are written. Set on the Container App by Terraform; set
# here only if you are pointing a local run at the real account. There is no
# connection string because shared keys are disabled on that account — auth is
# the app's managed identity, or your own az login.
AZURE_STORAGE_ACCOUNT=
AZURE_UPLOADS_CONTAINER=uploads

# --- Photo moderation -------------------------------------------------------
# Stage 3: Content Safety, which runs before the photo is stored and long before
# a model sees it. Also set on the Container App by Terraform; the same managed
# identity authenticates, so again there is no key. Leaving it empty is a
# startup failure rather than a quiet one: a moderator that could not be built
# would fail closed on every upload, which looks exactly like a Content Safety
# outage and takes a day to tell apart from one.
AZURE_CONTENT_SAFETY_ENDPOINT=

# The severity at which each category refuses, on Content Safety's four-level
# image scale: 0, 2, 4, 6. Optional, and defaulted in code to 2 everywhere
# except Violence, which is 4 because knives and raw meat are ordinary food
# photography. Only 2, 4 and 6 are accepted — there is deliberately no value
# meaning "never refuse". See vision/README.md for the argument behind each.
CHIP_CHAT_MODERATION_HATE_BLOCK_AT=
CHIP_CHAT_MODERATION_SELF_HARM_BLOCK_AT=
CHIP_CHAT_MODERATION_SEXUAL_BLOCK_AT=
CHIP_CHAT_MODERATION_VIOLENCE_BLOCK_AT=
CHIP_CHAT_MODERATION_UNKNOWN_BLOCK_AT=

# --- Photo matching ---------------------------------------------------------
# Stage 5: the lowest confidence each described slot may be believed at, and
# whether a draft can be proposed without it. All optional and all defaulted in
# code — protein highest, because a wrong protein is a different meal, and the
# two optional slots lowest, because their floor decides what is silently
# dropped rather than what is asked about. Unset means the defaults; a value
# that does not parse fails at startup, because a misspelled threshold that
# quietly kept the default would be a tuning run that measured the wrong number.
#
# These are the numbers issue #56 exists to move against the labeled photo set.
# vision/README.md argues each one.
CHIP_CHAT_MATCHER_VESSEL_THRESHOLD=
CHIP_CHAT_MATCHER_PROTEIN_THRESHOLD=
CHIP_CHAT_MATCHER_RICE_THRESHOLD=
CHIP_CHAT_MATCHER_BEANS_THRESHOLD=
CHIP_CHAT_MATCHER_SALSAS_THRESHOLD=
CHIP_CHAT_MATCHER_TOPPINGS_THRESHOLD=

# Whether falling below that floor escalates to a clarifying question (required)
# or silently drops the slot (optional). The published modifier grammar is per
# item_type — a taco has no rice group at all — so this is configuration rather
# than a constant. Accepts true/false, yes/no, on/off, 1/0.
CHIP_CHAT_MATCHER_VESSEL_REQUIRED=
CHIP_CHAT_MATCHER_PROTEIN_REQUIRED=
CHIP_CHAT_MATCHER_RICE_REQUIRED=
CHIP_CHAT_MATCHER_BEANS_REQUIRED=
CHIP_CHAT_MATCHER_SALSAS_REQUIRED=
CHIP_CHAT_MATCHER_TOPPINGS_REQUIRED=
