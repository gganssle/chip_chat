# Chip Chat — local configuration template.
#
# Copy to .env and fill in. Every value here is a NAME or an ID, never a
# credential: secrets live in Key Vault and are read at runtime over the
# credential `az login` writes. See docs/local-setup.md, "How secrets reach a
# local process".
#
#   cp .env.example .env
#
# .env is gitignored. If you ever find yourself putting a password, token or key
# in it, stop — that value belongs in Key Vault.

# --- Azure ------------------------------------------------------------------
AZURE_SUBSCRIPTION_ID=c8b63a71-218d-4d4c-991c-b963ed2fd1f0
AZURE_TENANT_ID=afededb7-6b20-4ec3-afd5-b27ac9242bbf
AZURE_RESOURCE_GROUP=rg-chip-chat
AZURE_LOCATION=eastus2

# The vault every secret is read from. Not a secret itself.
AZURE_KEY_VAULT_NAME=kv-chip-chat-c8b63a
AZURE_KEY_VAULT_URI=https://kv-chip-chat-c8b63a.vault.azure.net/

# --- Microsoft Foundry ------------------------------------------------------
# The account, and which deployment answers for which lane. Read the live values
# with `make infra-output`; none of them are secrets.
#
# The two deployment variables are the swap point for a Phase 9 eval experiment:
# add a deployment to var.model_deployments in Terraform, point a lane at it
# here, and no code changes. Deployment names are model names on purpose, so an
# experiment never has to rename what something else is already pointing at.
CHIP_CHAT_FOUNDRY_ENDPOINT=https://aif-chip-chat-4cy39i.cognitiveservices.azure.com/
CHIP_CHAT_FOUNDRY_CHAT_DEPLOYMENT=gpt-5-mini
CHIP_CHAT_FOUNDRY_VISION_DEPLOYMENT=gpt-4.1-mini

# Pinned, not floating: a newer api-version is a different response shape, and
# Phase 9 reads its numbers off this tier.
CHIP_CHAT_FOUNDRY_API_VERSION=2024-10-21

# The Agents data-plane endpoint — threads live here. `make infra-output` prints
# it as foundry_project_endpoints["AI Foundry API"].
CHIP_CHAT_FOUNDRY_PROJECT_ENDPOINT=https://aif-chip-chat-4cy39i.services.ai.azure.com/api/projects/proj-chip-chat

# Where the photo lane's uploads live. Shared keys are disabled on this account,
# so this is a name and not a credential — reads go through your own identity.
CHIP_CHAT_UPLOADS_ACCOUNT=stchipchat4cy39i
CHIP_CHAT_UPLOADS_CONTAINER=uploads

# Document Intelligence, which reads any PDF nutrition sheets the harvest finds
# (issue #22). The `document_intelligence_endpoint` Terraform output — a hostname,
# not a credential; the token comes from `az login` or the container's managed
# identity. Leave it empty and the harvest still runs: it is only needed if a PDF
# is actually found, and Chipotle publishes none today.
CHIP_CHAT_DOCUMENT_INTELLIGENCE_ENDPOINT=https://di-chip-chat-4cy39i.cognitiveservices.azure.com/

# --- Databricks -------------------------------------------------------------
# Empty until the workspace exists (Phase 2). Authentication is OAuth U2M via
# `databricks auth login`, which stores its own token — no value goes here.
DATABRICKS_HOST=
DATABRICKS_CONFIG_PROFILE=chip-chat

# --- Snowflake --------------------------------------------------------------
# Empty until the trial starts at Phase 4 — deliberately, see issue #40.
# The connection is defined by `snow connection add`; only names go here.
SNOWFLAKE_CONNECTION_NAME=chip-chat
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_WAREHOUSE=
SNOWFLAKE_DATABASE=

# --- Observability ----------------------------------------------------------
# Where spans go. Nothing reads this file automatically — `make dev` and
# `make trace` supply the local default themselves, and these lines matter only
# if you export them into your own shell. They are here because this is where
# you will look when repointing at Arize AX (issue #78), which is an endpoint
# and a header and nothing else. See docs/local-tracing.md.
#
# The local Phoenix container from `make dev`:
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:6006

# `k=v,k=v`. Empty locally; Arize AX wants an api_key and a space_id here — and
# those are secrets, so they come out of Key Vault rather than living in .env.
OTEL_EXPORTER_OTLP_HEADERS=

# `deployment.environment` on every span. Keeps local traces out of the views
# that are supposed to be about the deployed app.
CHIP_CHAT_ENVIRONMENT=local

# --- Spend cap --------------------------------------------------------------
# The inline daily ceiling and the layers under it. Every one is optional and
# defaulted small in code; see api/README.md. These are limits, not secrets.
CHIP_CHAT_DAILY_TOKEN_CEILING=
CHIP_CHAT_SESSION_TURN_CAP=
CHIP_CHAT_SESSION_TOKEN_CAP=
CHIP_CHAT_SOURCE_REQUESTS_PER_WINDOW=
CHIP_CHAT_SOURCE_WINDOW_SECONDS=
CHIP_CHAT_TURN_TOKEN_RESERVATION=

# "Daily" means nothing without this. Default UTC.
CHIP_CHAT_BUDGET_RESET_TIMEZONE=

# The circuit breaker. Anything not recognisably off ("", 0, false, no, off,
# run) stops the app on the next check — no restart, no deploy.
CHIP_CHAT_KILL_SWITCH=

# --- Photo uploads ----------------------------------------------------------
# Stages 1 and 2 of the vision pipeline: the ceilings a hostile upload runs into
# and the resolution a photo is reduced to. Optional and defaulted small in
# code; see vision/README.md. Limits, not secrets.
CHIP_CHAT_UPLOAD_MAX_BYTES=
CHIP_CHAT_UPLOAD_MAX_PIXELS=
CHIP_CHAT_UPLOAD_MAX_EDGE=
CHIP_CHAT_UPLOAD_JPEG_QUALITY=

# Where accepted photos are written. Set on the Container App by Terraform; set
# here only if you are pointing a local run at the real account. There is no
# connection string because shared keys are disabled on that account — auth is
# the app's managed identity, or your own az login.
AZURE_STORAGE_ACCOUNT=
AZURE_UPLOADS_CONTAINER=uploads

# --- Photo moderation -------------------------------------------------------
# Stage 3: Content Safety, which runs before the photo is stored and long before
# a model sees it. Also set on the Container App by Terraform; the same managed
# identity authenticates, so again there is no key. Leaving it empty is a
# startup failure rather than a quiet one: a moderator that could not be built
# would fail closed on every upload, which looks exactly like a Content Safety
# outage and takes a day to tell apart from one.
AZURE_CONTENT_SAFETY_ENDPOINT=

# The severity at which each category refuses, on Content Safety's four-level
# image scale: 0, 2, 4, 6. Optional, and defaulted in code to 2 everywhere
# except Violence, which is 4 because knives and raw meat are ordinary food
# photography. Only 2, 4 and 6 are accepted — there is deliberately no value
# meaning "never refuse". See vision/README.md for the argument behind each.
CHIP_CHAT_MODERATION_HATE_BLOCK_AT=
CHIP_CHAT_MODERATION_SELF_HARM_BLOCK_AT=
CHIP_CHAT_MODERATION_SEXUAL_BLOCK_AT=
CHIP_CHAT_MODERATION_VIOLENCE_BLOCK_AT=
CHIP_CHAT_MODERATION_UNKNOWN_BLOCK_AT=
