# Chip Chat — local configuration template.
#
# Copy to .env and fill in. Every value here is a NAME or an ID, never a
# credential: secrets live in Key Vault and are read at runtime over the
# credential `az login` writes. See docs/local-setup.md, "How secrets reach a
# local process".
#
#   cp .env.example .env
#
# .env is gitignored. If you ever find yourself putting a password, token or key
# in it, stop — that value belongs in Key Vault.

# --- Azure ------------------------------------------------------------------
AZURE_SUBSCRIPTION_ID=c8b63a71-218d-4d4c-991c-b963ed2fd1f0
AZURE_TENANT_ID=afededb7-6b20-4ec3-afd5-b27ac9242bbf
AZURE_RESOURCE_GROUP=rg-chip-chat
AZURE_LOCATION=eastus2

# The vault every secret is read from. Not a secret itself.
AZURE_KEY_VAULT_NAME=kv-chip-chat-c8b63a
AZURE_KEY_VAULT_URI=https://kv-chip-chat-c8b63a.vault.azure.net/

# --- Databricks -------------------------------------------------------------
# Empty until the workspace exists (Phase 2). Authentication is OAuth U2M via
# `databricks auth login`, which stores its own token — no value goes here.
DATABRICKS_HOST=
DATABRICKS_CONFIG_PROFILE=chip-chat

# --- Snowflake --------------------------------------------------------------
# Empty until the trial starts at Phase 4 — deliberately, see issue #40.
# The connection is defined by `snow connection add`; only names go here.
SNOWFLAKE_CONNECTION_NAME=chip-chat
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_WAREHOUSE=
SNOWFLAKE_DATABASE=

# --- Observability ----------------------------------------------------------
# Where spans go. Nothing reads this file automatically — `make dev` and
# `make trace` supply the local default themselves, and these lines matter only
# if you export them into your own shell. They are here because this is where
# you will look when repointing at Arize AX (issue #78), which is an endpoint
# and a header and nothing else. See docs/local-tracing.md.
#
# The local Phoenix container from `make dev`:
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:6006

# `k=v,k=v`. Empty locally; Arize AX wants an api_key and a space_id here — and
# those are secrets, so they come out of Key Vault rather than living in .env.
OTEL_EXPORTER_OTLP_HEADERS=

# `deployment.environment` on every span. Keeps local traces out of the views
# that are supposed to be about the deployed app.
CHIP_CHAT_ENVIRONMENT=local
