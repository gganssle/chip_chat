# Copy to terraform.tfvars and edit. terraform.tfvars is gitignored; this file is
# not. Nothing here is a secret — secrets live in Key Vault and never reach
# Terraform.
#
# Every value below is already the default. The file exists to show the shape of
# the two things you are most likely to change.

# subscription_id = "c8b63a71-218d-4d4c-991c-b963ed2fd1f0"
# location        = "eastus2"
# environment     = "demo"

# --- A disposable second stack ----------------------------------------------
#
# Set environment to anything but "demo" and the stack builds its own resource
# group, Key Vault and identity beside the live one instead of adopting Phase 0's.
#
#   terraform workspace new scratch
#   terraform apply -var environment=scratch -var adopt_existing_foundation=false
#
# The F0 Cognitive Services tiers are one-per-subscription per kind, so a second
# stack has to pay for them or the apply fails on a quota error. AI Search Free
# is one-per-subscription too, but var.search_sku already defaults to "basic"
# (see that variable), so a scratch stack inherits a paid tier without asking —
# ~$74/month per stack, and it bills whether or not the stack is used:
#
# environment               = "scratch"
# adopt_existing_foundation = false
# content_safety_sku        = "S0"
# document_intelligence_sku = "S0"

# --- Model deployments (issue #8) -------------------------------------------
#
# Empty by default: #5 stands up the environment, #8 chooses the models and
# confirms in-region quota. Capacity is thousands of tokens per minute and is a
# spend control as much as a performance setting — check available quota with
#
#   az cognitiveservices usage list -l eastus2 -o table
#
# before raising it.
#
# model_deployments = {
#   chat = {
#     model_name    = "gpt-4.1-mini"
#     model_version = "2025-04-14"
#     sku_name      = "GlobalStandard"
#     capacity      = 10
#   }
#   vision = {
#     model_name    = "gpt-4.1-mini"
#     model_version = "2025-04-14"
#     sku_name      = "GlobalStandard"
#     capacity      = 10
#   }
# }

# --- Databricks (issue #31) -------------------------------------------------
#
# Every value below is already the default. Two are worth knowing about.
#
# The node type is NOT the obvious one. East US 2 will not start most 4-vCPU
# types on this subscription: Standard_D4ds_v5 (Databricks' own default) has a
# quota of zero cores, and D4ds_v4 / DS3_v2 / F4s_v2 / D4s_v3 / E4ds_v4 are not
# offered in the region at all. Neither failure shows up at plan time. Check
# both before changing it:
#
#   az vm list-usage -l eastus2 -o table
#   az vm list-skus -l eastus2 --resource-type virtualMachines \
#     --query "[?name=='Standard_F4ads_v7'].{n:name,f:family,r:restrictions}"
#
# databricks_node_type               = "Standard_F4ads_v7"
# databricks_autotermination_minutes = 10

# The app tier authenticates to Databricks with the id-chip-chat-app managed
# identity, so there is no PAT and nothing in Key Vault to rotate. Turning this
# on ALSO needs an account admin to enable on-behalf-of tokens at
# accounts.azuredatabricks.net -> Settings -> Feature enablement.
#
# databricks_service_principal_token_enabled = false

# Escape hatch, not a design choice: set false only if the Databricks account
# has no auto-assign metastore in this region yet, so the rest of the stack can
# apply while someone sets one.
#
# databricks_unity_catalog_enabled = true
