# --- Python -----------------------------------------------------------------
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
build/
dist/

# --- Tooling caches ---------------------------------------------------------
.mypy_cache/
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# --- Secrets and local config -----------------------------------------------
.env
.env.*
!.env.example
*.pem
*.key

# --- Terraform --------------------------------------------------------------
.terraform/
# .terraform.lock.hcl is deliberately NOT ignored: it pins provider versions and
# checksums, which is the only thing making `terraform plan` reproducible
# between a laptop and CI.
*.tfstate
*.tfstate.*
*.tfvars
!*.tfvars.example
tfplan
*.tfplan
crash.log
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# --- Harvested and generated data -------------------------------------------
harvest/cache/
harvest/output/
data-gen/output/
data/generated/

# The landing zone the harvest and the weekly re-harvest (gh-38) write to.
# `make reharvest LANDING=...` puts it wherever you say; `landing/` is the
# default and the name every command in the docs uses.
landing/

# The rendered change report a re-harvest is asked to write outside the landing
# zone -- a CI artefact, not a source file.
change-report.md

# --- The ops API's deployment payload ---------------------------------------
# `make ops-package` builds the workspace into wheels beside the Functions host,
# because `api/functions/requirements.txt` installs them from the payload rather
# than from an index. They are build output of this repository and are rebuilt
# from the current tree on every deploy, so a committed copy could only ever be
# a stale one that looked authoritative.
api/functions/wheels/
# Where a developer would put a Snowflake key to run the host locally. The
# deployed app reads its credentials through Key Vault references; this file is
# the local equivalent and belongs on no machine but the one that wrote it.
api/functions/local.settings.json

# --- Node (web/) ------------------------------------------------------------
node_modules/
.next/
web/dist/

# --- Editors and OS ---------------------------------------------------------
.DS_Store
.idea/
.vscode/

# --- Beads / Dolt files (added by bd init) ----------------------------------
.dolt/
*.db
.beads-credential-key
.beads/proxieddb/

# --- Gas Town session runtime state (per-worktree, never shared) -------------
# Each worktree running a session rewrites these. Tracking them makes two
# polecat branches conflict on files whose content is meaningless.
.runtime/

# --- Agent worktrees ---------------------------------------------------------
# `EnterWorktree` and the Agent tool's worktree isolation both check out full
# copies of this repository under here. Two consequences, and the second is the
# one that bites: they must never be committed, and `ruff format --check .` from
# the main checkout walks into them and fails on another agent's half-written
# file. `[tool.ruff] extend-exclude` in pyproject.toml is the other half of this.
.claude/worktrees/

# Scratch scripts used to drive the live deployment by hand.
.order.sh
