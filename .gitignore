# --- Python -----------------------------------------------------------------
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
build/
dist/

# --- Tooling caches ---------------------------------------------------------
.mypy_cache/
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# --- Secrets and local config -----------------------------------------------
.env
.env.*
!.env.example
*.pem
*.key

# --- Terraform --------------------------------------------------------------
.terraform/
# .terraform.lock.hcl is deliberately NOT ignored: it pins provider versions and
# checksums, which is the only thing making `terraform plan` reproducible
# between a laptop and CI.
*.tfstate
*.tfstate.*
*.tfvars
!*.tfvars.example
tfplan
*.tfplan
crash.log
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# --- Harvested and generated data -------------------------------------------
harvest/cache/
harvest/output/
data-gen/output/
data/generated/

# --- Node (web/) ------------------------------------------------------------
node_modules/
.next/
web/dist/

# --- Editors and OS ---------------------------------------------------------
.DS_Store
.idea/
.vscode/

# --- Beads / Dolt files (added by bd init) ----------------------------------
.dolt/
*.db
.beads-credential-key
.beads/proxieddb/

# --- Gas Town session runtime state (per-worktree, never shared) -------------
# Each worktree running a session rewrites these. Tracking them makes two
# polecat branches conflict on files whose content is meaningless.
.runtime/
