         "title": "Delivery - General ",
         "questions": [
          {
           "question": "Can I cancel my delivery after I've submitted my order?",
           "answer": {
            "json": [
             {
              "nodeType": "paragraph",
              "content": [
               {
                "nodeType": "text",
                "value": "When you submit a delivery order, it's sent directly to our courier team and restaurant crew, so it can get cooked up and on its way to you. That makes canceling orders sort of a challenge. If you really must cancel, and you've ordered directly through our app or online, reach out to our Customer Service team through the "
               },
               {
                "nodeType": "link",
                "content": [
                 {
                  "nodeType": "text",
                  "value": "Contact Us"
                 }
                ],
                "data": {
                 "href": "https://www.chipotle.com/content/chipotle/us/en/contact-us.html"
                }
               },
               {
                "nodeType": "text",
                "value": " page. If you ordered through a partner, check your confirmation email to contact their team directly. Keep in mind that you may incur a cancelation fee."
               }
              ]
             }
            ]
           },
           "isactive": false,
           "rank": 5,
           "topQuestion": true
          }
         ]
        },
